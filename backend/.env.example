# Copia este archivo como backend/.env y pon tu clave real.
# backend/.env esta en .gitignore: nunca se sube a GitHub.

# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=pon-aqui-tu-clave

# Opcional: modelo de Gemini (por defecto gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: puerto local (por defecto 5000; el frontend en local llama a 127.0.0.1:5000)
# PORT=5000
